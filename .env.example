# Base URL of the existing Audit Jiwa backend/API that this front-end calls.
# In production this should point at the deployed Audit Jiwa API host.
# Leave blank locally if you're proxying via vite.config.ts instead.
VITE_API_BASE_URL=

# Supabase — provisioned via the Vercel Marketplace integration
# (`vercel integration add supabase`, connected to this project). Anon key
# only: safe to expose client-side, every table it can touch is behind RLS
# (see supabase/migrations/). `vercel env pull .env.local` re-syncs the
# NEXT_PUBLIC_/bare SUPABASE_* names the integration itself writes; these
# VITE_-prefixed ones are hand-aliased from those since this is a Vite app,
# not Next.js — see .env.local's own comment. Never add a VITE_ alias for
# SUPABASE_SERVICE_ROLE_KEY/SUPABASE_SECRET_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
