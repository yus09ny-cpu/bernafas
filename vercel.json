{
  "rewrites": [
    { "source": "/((?!api/|src/|@vite|@react-refresh|node_modules/)(?!.*\\.[^/]+$).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/affiliate.ts": {
      "maxDuration": 60,
      "includeFiles": "buku/**"
    },
    "api/book/full.ts": {
      "maxDuration": 60,
      "includeFiles": "buku/**"
    }
  },
  "crons": [
    { "path": "/api/check-subscriptions", "schedule": "0 0 * * *" }
  ]
}
